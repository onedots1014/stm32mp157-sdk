#!/bin/sh

case "$1" in
    start)
        saved_config=/etc/wpa_supplicant.saved.conf
        umask 077
        mkdir -p /var/run/wpa_supplicant || exit 1
        if [ -s "$saved_config" ]; then
            config=$saved_config
            echo "WiFi: using saved credentials."
        else
            # BusyBox ash provides read -t/-s.
            if [ ! -t 0 ]; then
                echo "WiFi: no interactive terminal, skipping."
                exit 0
            fi
            printf 'WiFi SSID (Enter to skip, 15s timeout): '
            if ! IFS= read -r -t 15 ssid || [ -z "$ssid" ]; then
                echo
                echo "WiFi: skipped."
                exit 0
            fi
            printf 'WiFi password (hidden, Enter to skip, 30s timeout): '
            if ! IFS= read -r -s -t 30 password || [ -z "$password" ]; then
                echo
                echo "WiFi: skipped."
                exit 0
            fi
            echo
            # Feed the password on stdin rather than exposing it in argv.
            network=$(printf '%s\n' "$password" | wpa_passphrase "$ssid")
            result=$?
            unset password
            if [ "$result" -ne 0 ]; then
                echo "WiFi: invalid credentials (WPA password must be 8-63 characters)."
                exit 1
            fi
            umask 077
            mkdir -p /var/run/wpa_supplicant || exit 1
            config=$(mktemp /var/run/wpa_supplicant/network.XXXXXX) || exit 1
            # wpa_passphrase includes a plaintext password comment: remove it.
            printf '%s\n' "$network" | sed '/^[[:space:]]*#psk=/d' > "$config"
            unset network
            trap 'rm -f "$config"' EXIT
            trap 'exit 1' HUP INT TERM
        fi

        echo "Starting WiFi..."
        modprobe bcmdhd
        sleep 2
        if ! ifconfig wlan0 up; then
            echo "WiFi: wlan0 did not come up, skipping wpa_supplicant/udhcpc"
            exit 1
        fi
        mkdir -p /var/run/wpa_supplicant
        wpa_supplicant -B -i wlan0 -c "$config" -P /var/run/wpa_supplicant/wlan0.pid || exit 1
        # Wait for association and the WPA handshake before asking for an
        # address: operstate turns "up" only once the link is usable. DHCP
        # requests sent earlier are lost, and udhcpc then waits ~20 s
        # before retrying in the background.
        i=0
        while [ "$(cat /sys/class/net/wlan0/operstate 2>/dev/null)" != up ] && [ $i -lt 15 ]; do
            sleep 1
            i=$((i + 1))
        done
        if [ "$(cat /sys/class/net/wlan0/operstate 2>/dev/null)" != up ]; then
            echo "WiFi: association timed out, skipping DHCP."
            kill "$(cat /var/run/wpa_supplicant/wlan0.pid)" 2>/dev/null
            exit 1
        fi
        # Persist only after association succeeds; keep the previous file intact
        # until its replacement is complete. /var/run is lost on power-off.
        if [ "$config" != "$saved_config" ]; then
            saved_tmp=$(mktemp "${saved_config}.XXXXXX")
            if [ -n "$saved_tmp" ] &&
                cat "$config" > "$saved_tmp" &&
                mv -f "$saved_tmp" "$saved_config"; then
                sync
                echo "WiFi: credentials saved for future boots."
            else
                [ -z "$saved_tmp" ] || rm -f "$saved_tmp"
                echo "WiFi: could not save credentials; next boot will prompt again."
            fi
        fi
        # -b: go to the background if no lease yet, so a missing AP or a
        # down link cannot hold up the rest of boot (and the console)
        udhcpc -b -i wlan0
        echo "WiFi started."
        ;;
    stop)
        echo "Stopping WiFi..."
        kill $(cat /var/run/wpa_supplicant/wlan0.pid 2>/dev/null) 2>/dev/null
        killall udhcpc 2>/dev/null
        ifconfig wlan0 down
        rmmod bcmdhd 2>/dev/null
        echo "WiFi stopped."
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
