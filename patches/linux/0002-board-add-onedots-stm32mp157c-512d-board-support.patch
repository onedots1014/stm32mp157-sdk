 arch/arm/boot/dts/stm32mp157-onedots.dtsi     | 494 ++++++++++++++++++
 .../boot/dts/stm32mp157c-onedots-512d-v1.dts  |  30 ++
 .../arm/configs/onedots_stm32mp157c_defconfig |  21 +
 6 files changed, 825 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boot/dts/stm32mp157-onedots-board.dtsi
