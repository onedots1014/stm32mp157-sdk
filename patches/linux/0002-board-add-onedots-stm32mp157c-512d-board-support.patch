+
+#include <dt-bindings/pinctrl/stm32-pinfunc.h>
+#include "stm32mp157-onedots.dtsi"
+#include "stm32mp157-onedots-pinctrl.dtsi"
+#include "stm32mp157-onedots-board.dtsi"
+
+/ {
+	model = "Onedots STM32MP157C Development Board";
+	compatible = "st,stm32mp157c-onedots-512d-v1", "st,stm32mp157";
+	
+	/* Package type specification to eliminate warnings */
+	st,package = <STM32MP_PKG_AC>;
+	
+	aliases {
+		serial0 = &uart4; /* Debug console */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "root=/dev/mmcblk0p3 rootwait rw console=ttySTM0,115200 init=/sbin/init";
+	};
+};
