+/* calculate checksum for ip header, tcp / udp header / data */
+uint16
+bcm_ip_cksum(uint8 *buf, uint32 len, uint32 sum)
+{
+	while (len > 1) {
+		sum += (uint32)((buf[0] << 8) | buf[1]);
+		buf += 2;
+		len -= 2;
+	}
+
+	if (len > 0) {
+		sum += (uint32)((*buf) << 8);
+	}
+
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+
+	return ((uint16)~sum);
+}
