+void
+dhd_init_bus_lock(dhd_bus_t *bus)
+{
+	if (!bus->bus_lock) {
+		bus->bus_lock = dhd_os_spin_lock_init(bus->dhd->osh);
+	}
+}
+
+void
+dhd_deinit_bus_lock(dhd_bus_t *bus)
+{
+	if (bus->bus_lock) {
+		dhd_os_spin_lock_deinit(bus->dhd->osh, bus->bus_lock);
+		bus->bus_lock = NULL;
+	}
+}
