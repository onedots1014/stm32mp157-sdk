+#define NAN_EV_MASK_SET(var, evt)	\
+	((evt < WL_NAN_EVMASK_EXTN_LEN * 8) ? \
+	((*((uint8 *)var + ((evt - 1)/8))) |= (1 << ((evt - 1) %8))) : 0)
