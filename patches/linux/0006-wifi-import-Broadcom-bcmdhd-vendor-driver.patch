+static bool
+wl_ext_radar_detect(struct net_device *dev)
+{
+	int ret = BCME_OK;
+	bool radar = FALSE;
+	s32 val = 0;
+
+	if ((ret = wldev_ioctl(dev, WLC_GET_RADAR, &val, sizeof(int), false) == 0)) {
+		radar = TRUE;
+	}
+
+	return radar;
+}
