+	struct timer_list join_timer;
+	u32 join_timeout_val;
+	bool join_timer_active;
+	uint scan_time_count;
+	struct timer_list scan_timer;
+	bool scan_timer_active;
+#endif // endif
+#if defined(DHD_LB)
+	/* CPU Load Balance dynamic CPU selection */
+
