index 000000000..6ceabb7a5
--- /dev/null
+++ b/drivers/net/wireless/bcmdhd/include/802.11s.h
@@ -0,0 +1,334 @@
+/*
+ * Fundamental types and constants relating to 802.11s Mesh
+ *
