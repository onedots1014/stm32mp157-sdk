+uint64
+osl_sysuptime_us(void)
+{
+	struct osl_timespec tv;
+	uint64 usec;
+
+	osl_do_gettimeofday(&tv);
+	/* tv_usec content is fraction of a second */
+	usec = (uint64)tv.tv_sec * 1000000ul + tv.tv_usec;
+	return usec;
