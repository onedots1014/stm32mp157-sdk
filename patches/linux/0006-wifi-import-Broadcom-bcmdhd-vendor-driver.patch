+
+		printf("\nMemtype: %s\n", hndmem_type_str[mem]);
+		for (bank = 0; bank < bank_cnt; bank++) {
+			bank_sz = hndmem_bank_size(sih, mem, bank);
+			printf("Bank-%d: %d KB\n", bank, bank_sz);
