+	C2S(NAN_ATTRIBUTE_DWELL_TIME_5G)
+	C2S(NAN_ATTRIBUTE_SCAN_PERIOD_5G)
+	C2S(NAN_ATTRIBUTE_SUB_SID_BEACON)
+	default:
+		return "NAN_ATTRIBUTE_UNKNOWN";
+	}
+}
