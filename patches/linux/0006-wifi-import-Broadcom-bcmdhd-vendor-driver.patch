+			default:
+				WL_ERR(("Unknown type: %d\n", type));
+				return err;
+		}
+	}
+	/* country code is unique for dongle..hence using primary interface. */
+	err = wl_cfg80211_set_country_code(primary_ndev, country_code, true, true, -1);
+	if (err < 0) {
+		WL_ERR(("Set country failed ret:%d\n", err));
