 #include "stm32mp157-onedots.dtsi"
 #include "stm32mp157-onedots-pinctrl.dtsi"
 #include "stm32mp157-onedots-board.dtsi"
+#include "stm32mp157-onedots-audio.dtsi"
 
 / {
 	model = "Onedots STM32MP157C Development Board";
diff --git a/arch/arm/configs/onedots_stm32mp157c_defconfig b/arch/arm/configs/onedots_stm32mp157c_defconfig
index 7d3deff10..47ba56b6d 100644
--- a/arch/arm/configs/onedots_stm32mp157c_defconfig
+++ b/arch/arm/configs/onedots_stm32mp157c_defconfig
@@ -27,3 +27,32 @@ CONFIG_RPMSG_VIRTIO=y
 CONFIG_RPMSG_TTY=y
 CONFIG_EXT4_FS=y
 CONFIG_CRYPTO_DEV_VIRTIO=y
