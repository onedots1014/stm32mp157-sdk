From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: onedots <onedots0@outlook.com>
Date: Fri, 3 Jul 2026 23:48:30 -0700
Subject: [PATCH] audio: enable WM8960 codec via SAI1 (SAI1_K on PLL3_Q)

---
 .../boot/dts/stm32mp157-onedots-audio.dtsi    | 112 ++++++++++++++++++
 .../boot/dts/stm32mp157-onedots-board.dtsi    |  12 +-
 .../boot/dts/stm32mp157-onedots-pinctrl.dtsi  |  55 +++++++++
 .../boot/dts/stm32mp157c-onedots-512d-v1.dts  |   1 +
 .../arm/configs/onedots_stm32mp157c_defconfig |  29 +++++
 5 files changed, 208 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boot/dts/stm32mp157-onedots-audio.dtsi

diff --git a/arch/arm/boot/dts/stm32mp157-onedots-audio.dtsi b/arch/arm/boot/dts/stm32mp157-onedots-audio.dtsi
new file mode 100644
index 000000000..b06616bf4
--- /dev/null
+++ b/arch/arm/boot/dts/stm32mp157-onedots-audio.dtsi
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * WM8960 audio codec - CA7 playback via SAI1_A (audio-graph-card)
+ *
+ * Hardware connections:
+ *   SAI1_A: PB2=SD_A(DACDAT) - data to WM8960 DAC input
+ *   SAI1_B: PF7=MCLK_B, PF8=SCK_B(BCLK), PF9=FS_B(LRCLK) - clocks
+ *           PF6=SD_B(ADCDAT) - data from WM8960 ADC output (not used by CA7)
+ *   I2C1:   PF14=SCL, PF15=SDA  -> WM8960 control
+ *
+ * CA7 owns: SAI1_A (TX slave, playback via st,sync from SAI1_B) + I2C1 (codec config)
+ * SAI1_B:   MCLK provider (12.288MHz) + clock master (BCLK/LRCLK generated by WM8960)
+ * M4 uses:  SAI1_A (TX slave) + SAI1_B (RX master) - handled separately by M4 firmware
+ */
+
+/* audio-graph-card machine driver */
+/ {
+	sound_wm8960: sound {
+		compatible = "audio-graph-card";
+		label = "WM8960-onedots";
+		dais = <&sai1a_port>;
+		widgets =
+			"Headphone", "Headphone Jack",
+			"Microphone", "Microphone Jack",
+			"Speaker", "Left Speaker",
+			"Speaker", "Right Speaker";
+		routing =
+			"Headphone Jack", "HP_L",
+			"Headphone Jack", "HP_R",
+			"LINPUT1", "Microphone Jack",
+			"RINPUT1", "Microphone Jack",
+			"Left Speaker", "SPK_LP",
+			"Left Speaker", "SPK_LN",
+			"Right Speaker", "SPK_RP",
+			"Right Speaker", "SPK_RN";
+	};
+};
+
+/* SAI1 parent: clocks + pinctrl + reset */
+&sai1 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sai1a_pins_a &sai1b_pins_a>;
+	pinctrl-1 = <&sai1a_sleep_pins_a &sai1b_sleep_pins_a>;
+	clocks = <&rcc SAI1>, <&rcc PLL3_Q>, <&rcc PLL3_R>;
+	clock-names = "pclk", "x8k", "x11k";
+	status = "okay";
+};
+
+/* SAI1_A: TX slave, borrows SAI1_B clocks via st,sync
+ * Data pin: PB2 (SAI1_SD_A) -> WM8960 DACDAT
+ * WM8960 is I2S master: generates BCLK/LRCLK from its MCLK input
+ */
+&sai1a {
+	clocks = <&rcc SAI1_K>, <&sai1b>;
+	clock-names = "sai_ck", "MCLK";
+	dma-names = "tx";
+	st,sync = <&sai1b 1>;
+	status = "okay";
+
+	sai1a_port: port {
+		sai1a_endpoint: endpoint {
+			remote-endpoint = <&wm8960_endpoint>;
+			format = "i2s";
+			mclk-fs = <256>;
+			dai-tdm-slot-num = <2>;
+			dai-tdm-slot-width = <16>;
+		};
+	};
+};
+
+/* SAI1_B: MCLK provider for WM8960 (12.288MHz)
+ * Also provides BCLK/FS to SAI1_A via st,sync
+ * dmas inherited from stm32mp151.dtsi but not used by CA7
+ * #clock-cells = <0>: registers SAI1B as clock provider
+ */
+&sai1b {
+	dma-names = "rx";
+	#clock-cells = <0>;
+	/* Force enable MCLK at boot (wm8960 driver doesn't enable it automatically) */
+	assigned-clocks = <&sai1b>;
+	assigned-clock-rates = <12288000>;
+	status = "okay";
+};
+
+/* WM8960 on I2C1 */
+&i2c1 {
+	status = "okay";
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&i2c1_pins_a>;
+	pinctrl-1 = <&i2c1_sleep_pins_a>;
+	i2c-scl-rising-time-ns = <185>;
+	i2c-scl-falling-time-ns = <20>;
+
+	wm8960: wm8960@1a {
+		compatible = "wlf,wm8960";
+		reg = <0x1a>;
+		#sound-dai-cells = <0>;
+		clocks = <&sai1b>;
+		clock-names = "mclk";
+		wlf,shared-lrclk;
+		status = "okay";
+
+		port {
+			wm8960_endpoint: endpoint {
+				remote-endpoint = <&sai1a_endpoint>;
+				/* WM8960 is master: generates BCLK and LRCLK */
+				frame-master;
+				bitclock-master;
+			};
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/stm32mp157-onedots-board.dtsi b/arch/arm/boot/dts/stm32mp157-onedots-board.dtsi
index bc4298f2e..48dbed737 100644
--- a/arch/arm/boot/dts/stm32mp157-onedots-board.dtsi
+++ b/arch/arm/boot/dts/stm32mp157-onedots-board.dtsi
@@ -163,7 +163,6 @@
 	status = "okay";
 };
 
-
 /* eMMC Configuration */
 &sdmmc2 {
         pinctrl-names = "default", "opendrain", "sleep";
@@ -206,6 +205,14 @@
 	status = "okay";
 };
 
+/* SAI1_K clock config: set PLL3_Q as source via m4_rproc assigned-clocks.
+ * m4_rproc driver always probes, so clk_set_defaults() is guaranteed to run.
+ * SAI1_K = PLL3_Q ~24.576MHz → MCLK = 24.576MHz/2 = 12.288MHz = 256*48kHz */
+&sai1 {
+	clocks = <&rcc SAI1>, <&rcc PLL3_Q>, <&rcc PLL3_R>;
+	clock-names = "pclk", "x8k", "x11k";
+	status = "okay";
+};
 &m4_rproc {
     compatible = "st,stm32mp1-m4";
 
@@ -221,6 +228,9 @@
     wakeup-source;
     status = "okay";
 
+    assigned-clocks = <&rcc SAI1_K>;
+    assigned-clock-parents = <&rcc PLL3_Q>;
+
     m4_system_resources {
         m4_led: m4_led {
             compatible = "rproc-srm-dev";
diff --git a/arch/arm/boot/dts/stm32mp157-onedots-pinctrl.dtsi b/arch/arm/boot/dts/stm32mp157-onedots-pinctrl.dtsi
index 856d072bc..55ecf501e 100755
--- a/arch/arm/boot/dts/stm32mp157-onedots-pinctrl.dtsi
+++ b/arch/arm/boot/dts/stm32mp157-onedots-pinctrl.dtsi
@@ -123,5 +123,60 @@
 			pinmux = <STM32_PINMUX('A', 10, RSVD)>;
 		};
 	};
+
+	/* SAI1_A: playback data to WM8960 DACDAT (PB2 -> WM8960 pin 10) */
+	sai1a_pins_a: sai1a-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 2, AF6)>; /* SAI1_SD_A */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+	sai1a_sleep_pins_a: sai1a-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 2, ANALOG)>;
+		};
+	};
+
+	/* SAI1_B: clocks (MCLK/BCLK/LRCLK) + ADCDAT from WM8960 (PF6 <- WM8960 pin 8) */
+	sai1b_pins_a: sai1b-0 {
+		pins {
+			pinmux = <STM32_PINMUX('F', 6, AF6)>,  /* SAI1_SD_B */
+				 <STM32_PINMUX('F', 7, AF6)>,  /* SAI1_MCLK_B */
+				 <STM32_PINMUX('F', 8, AF6)>,  /* SAI1_SCK_B */
+				 <STM32_PINMUX('F', 9, AF6)>;  /* SAI1_FS_B */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+	sai1b_sleep_pins_a: sai1b-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('F', 6, ANALOG)>,
+				 <STM32_PINMUX('F', 7, ANALOG)>,
+				 <STM32_PINMUX('F', 8, ANALOG)>,
+				 <STM32_PINMUX('F', 9, ANALOG)>;
+		};
+	};
+
+	/* I2C1: WM8960 control interface */
+	i2c1_pins_a: i2c1-0 {
+		pins {
+			pinmux = <STM32_PINMUX('F', 14, AF5)>, /* I2C1_SCL */
+				 <STM32_PINMUX('F', 15, AF5)>; /* I2C1_SDA */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <0>;
+		};
+	};
+	i2c1_sleep_pins_a: i2c1-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('F', 14, ANALOG)>,
+				 <STM32_PINMUX('F', 15, ANALOG)>;
+		};
+	};
+
+	
 };
 
