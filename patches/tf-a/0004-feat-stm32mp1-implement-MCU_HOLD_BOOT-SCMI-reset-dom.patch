From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: onedots <onedots0@outlook.com>
Date: Wed, 4 Mar 2026 22:26:36 +0800
Subject: [PATCH] feat(stm32mp1): implement MCU_HOLD_BOOT SCMI reset domain for
 M4 remoteproc

---
 plat/st/stm32mp1/stm32mp1_scmi.c             | 18 +++++++++++++++++-
 plat/st/stm32mp1/stm32mp1_shared_resources.c |  2 ++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp1/stm32mp1_scmi.c b/plat/st/stm32mp1/stm32mp1_scmi.c
index 625d01a..b5917a1 100644
--- a/plat/st/stm32mp1/stm32mp1_scmi.c
+++ b/plat/st/stm32mp1/stm32mp1_scmi.c
@@ -15,6 +15,7 @@
 #include <drivers/st/stm32mp_reset.h>
 #include <dt-bindings/clock/stm32mp1-clks.h>
 #include <dt-bindings/reset/stm32mp1-resets.h>
+#include <lib/mmio.h>
 
 #define TIMEOUT_US_1MS		1000U
 
@@ -125,6 +126,7 @@ static struct stm32_scmi_rstd stm32_scmi0_reset_domain[] = {
 	RESET_CELL(RST_SCMI0_RNG1, RNG1_R, "rng1"),
 	RESET_CELL(RST_SCMI0_MDMA, MDMA_R, "mdma"),
 	RESET_CELL(RST_SCMI0_MCU, MCU_R, "mcu"),
+	RESET_CELL(RST_SCMI0_MCU_HOLD_BOOT, MCU_HOLD_BOOT_R, "mcu_hold_boot"),
 };
 
 struct scmi_agent_resources {
@@ -429,7 +431,21 @@ int32_t plat_scmi_rstd_set_state(unsigned int agent_id, unsigned int scmi_id,
 		return SCMI_DENIED;
 	}
 
-	if (assert_not_deassert) {
+	if (rstd->reset_id == MCU_HOLD_BOOT_R) {
+		/*
+		 * RCC_MP_GCR is a regular R/W register, not a SET/CLEAR pair.
+		 * Use read-modify-write instead of the generic reset driver.
+		 */
+		uintptr_t gcr_addr = stm32mp_rcc_base() + RCC_MP_GCR;
+
+		if (assert_not_deassert) {
+			VERBOSE("SCMI hold boot assert (MCU_BOOT=0)\n");
+			mmio_clrbits_32(gcr_addr, RCC_MP_GCR_BOOT_MCU);
+		} else {
+			VERBOSE("SCMI hold boot deassert (MCU_BOOT=1)\n");
+			mmio_setbits_32(gcr_addr, RCC_MP_GCR_BOOT_MCU);
+		}
+	} else if (assert_not_deassert) {
 		VERBOSE("SCMI reset %lu set\n", rstd->reset_id);
 		stm32mp_reset_set(rstd->reset_id);
 	} else {
diff --git a/plat/st/stm32mp1/stm32mp1_shared_resources.c b/plat/st/stm32mp1/stm32mp1_shared_resources.c
index a0ca697..3b40050 100644
--- a/plat/st/stm32mp1/stm32mp1_shared_resources.c
+++ b/plat/st/stm32mp1/stm32mp1_shared_resources.c
@@ -455,6 +455,8 @@ bool stm32mp_nsec_can_access_reset(unsigned int reset_id)
 	case MCU_R:
 		shres_id = STM32MP1_SHRES_MCU;
 		break;
+	case MCU_HOLD_BOOT_R:
+		return true;
 	case MDMA_R:
 		shres_id = STM32MP1_SHRES_MDMA;
 		break;
