From 764d42f80ea6adb603c2abd8c6e6848abb0a5ecc Mon Sep 17 00:00:00 2001
From: onedots <onedots0@outlook.com>
Date: Sat, 4 Jul 2026 07:55:02 -0700
Subject: [PATCH 5/5] fdts: rename onedots artifact namespace to quartzix
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Renames the board fdts files and fixes their #include chain to match.
Verified: BL2/BL32/fw-config flattened device trees recompile
byte-identical to the pre-rename build (dtc decompile + diff) — these
files never had onedots-branded content internally (model/compatible
were always the ST 'Belong' eval-board strings), so this is purely a
filename change with zero functional delta.
---
 ...b-fw-config.dts => quartzix-stm32mp157c-evb-fw-config.dts} | 0
 ...evb-pinctrl.dtsi => quartzix-stm32mp157c-evb-pinctrl.dtsi} | 0
 ...edots-stm32mp157c-evb.dts => quartzix-stm32mp157c-evb.dts} | 4 ++--
 ...ots-stm32mp157c-evb.dtsi => quartzix-stm32mp157c-evb.dtsi} | 2 +-
 ...binG.dtsi => quartzix_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi} | 0
 5 files changed, 3 insertions(+), 3 deletions(-)
 rename fdts/{onedots-stm32mp157c-evb-fw-config.dts => quartzix-stm32mp157c-evb-fw-config.dts} (100%)
 rename fdts/{onedots-stm32mp157c-evb-pinctrl.dtsi => quartzix-stm32mp157c-evb-pinctrl.dtsi} (100%)
 rename fdts/{onedots-stm32mp157c-evb.dts => quartzix-stm32mp157c-evb.dts} (84%)
 rename fdts/{onedots-stm32mp157c-evb.dtsi => quartzix-stm32mp157c-evb.dtsi} (98%)
 rename fdts/{onedots_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi => quartzix_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi} (100%)

diff --git a/fdts/onedots-stm32mp157c-evb-fw-config.dts b/fdts/quartzix-stm32mp157c-evb-fw-config.dts
similarity index 100%
rename from fdts/onedots-stm32mp157c-evb-fw-config.dts
rename to fdts/quartzix-stm32mp157c-evb-fw-config.dts
diff --git a/fdts/onedots-stm32mp157c-evb-pinctrl.dtsi b/fdts/quartzix-stm32mp157c-evb-pinctrl.dtsi
similarity index 100%
rename from fdts/onedots-stm32mp157c-evb-pinctrl.dtsi
rename to fdts/quartzix-stm32mp157c-evb-pinctrl.dtsi
diff --git a/fdts/onedots-stm32mp157c-evb.dts b/fdts/quartzix-stm32mp157c-evb.dts
similarity index 84%
rename from fdts/onedots-stm32mp157c-evb.dts
rename to fdts/quartzix-stm32mp157c-evb.dts
index 118ec1e..cc81212 100644
--- a/fdts/onedots-stm32mp157c-evb.dts
+++ b/fdts/quartzix-stm32mp157c-evb.dts
@@ -8,9 +8,9 @@
 
 #include "stm32mp157.dtsi"
 #include "stm32mp15xa.dtsi"
-#include  "onedots-stm32mp157c-evb-pinctrl.dtsi"
+#include  "quartzix-stm32mp157c-evb-pinctrl.dtsi"
 #include "stm32mp15xxac-pinctrl.dtsi"
-#include "onedots-stm32mp157c-evb.dtsi"
+#include "quartzix-stm32mp157c-evb.dtsi"
 
 / {
 	model = "Belong STM32MP157AAC Evb Board";
diff --git a/fdts/onedots-stm32mp157c-evb.dtsi b/fdts/quartzix-stm32mp157c-evb.dtsi
similarity index 98%
rename from fdts/onedots-stm32mp157c-evb.dtsi
rename to fdts/quartzix-stm32mp157c-evb.dtsi
index f0e35d3..9cddd1b 100644
--- a/fdts/onedots-stm32mp157c-evb.dtsi
+++ b/fdts/quartzix-stm32mp157c-evb.dtsi
@@ -6,7 +6,7 @@
 
 #include <dt-bindings/clock/stm32mp1-clksrc.h>
 #include <dt-bindings/power/stm32mp1-power.h>
-#include "onedots_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi"
+#include "quartzix_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi"
 
 / {
 	aliases {
diff --git a/fdts/onedots_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi b/fdts/quartzix_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi
similarity index 100%
rename from fdts/onedots_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi
rename to fdts/quartzix_stm32mp15-ddr3-2x2Gb-1066-binG.dtsi
