&pinctrl {

	m4_i2c1_pins_mx: m4_i2c1_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 14, RSVD)>, /* I2C1_SCL */
					 <STM32_PINMUX('F', 15, RSVD)>; /* I2C1_SDA */
		};
	};

	m4_sai1a_pins_mx: m4_sai1a_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 6, RSVD)>; /* SAI1_SD_A */
		};
	};

	m4_sai1b_pins_mx: m4_sai1b_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 6, RSVD)>, /* SAI1_SD_B */
					 <STM32_PINMUX('F', 7, RSVD)>, /* SAI1_MCLK_B */
					 <STM32_PINMUX('F', 8, RSVD)>, /* SAI1_SCK_B */
					 <STM32_PINMUX('F', 9, RSVD)>; /* SAI1_FS_B */
		};
	};

	m4_uart8_pins_mx: m4_uart8_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 0, RSVD)>, /* UART8_RX */
					 <STM32_PINMUX('E', 1, RSVD)>; /* UART8_TX */
		};
	};

	/* USER CODE BEGIN pinctrl */
	/* USER CODE END pinctrl */
};

